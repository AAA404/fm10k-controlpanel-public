ARG DEBIAN_IMAGE=public.ecr.aws/docker/library/debian:13-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132
FROM ${DEBIAN_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config libpcre2-dev libssl-dev libcap-dev \
    ca-certificates curl git python3 python3-venv python3-pip nodejs npm \
    python3-fastapi python3-pydantic python3-uvicorn python3-pytest python3-httpx \
    nginx openssl kmod dkms dpkg-dev fakeroot systemd linux-headers-amd64 \
    && rm -rf /var/lib/apt/lists/*
# libyang 2.x is isolated from Debian 13's system libyang ABI.
RUN curl -fsSL https://github.com/CESNET/libyang/archive/refs/tags/v2.1.148.tar.gz -o /tmp/libyang.tar.gz \
    && mkdir /tmp/libyang && tar -xzf /tmp/libyang.tar.gz -C /tmp/libyang --strip-components=1 \
    && cmake -S /tmp/libyang -B /tmp/libyang-build -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_INSTALL_PREFIX=/opt/netlab-deps/libyang2 -DCMAKE_INSTALL_LIBDIR=lib \
       -DENABLE_TESTS=OFF -DENABLE_BUILD_TESTS=OFF \
    && cmake --build /tmp/libyang-build -j2 && cmake --install /tmp/libyang-build \
    && rm -rf /tmp/libyang /tmp/libyang-build /tmp/libyang.tar.gz
ENV PKG_CONFIG_PATH=/opt/netlab-deps/libyang2/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/netlab-deps/libyang2/lib
# The public CLI namespace fixtures import the original CLI runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-prompt-toolkit python3-requests && rm -rf /var/lib/apt/lists/*
WORKDIR /src
CMD ["/bin/bash"]
