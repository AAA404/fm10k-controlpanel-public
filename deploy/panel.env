# Initial installation is a loopback-only simulator. Native mode requires the
# separately built NetLab services and the switchd board binding contract.
PANEL_BACKEND=mock
PANEL_STATE_DIR=/var/lib/fm10k-controlpanel
PANEL_STATIC_DIR=/usr/share/fm10k-controlpanel/web
PANEL_NETLAB_ROOT=/usr/lib/fm10k-controlpanel/netlab
# Set to 1 when using the HTTPS listener; native mode always uses Secure cookies.
PANEL_SECURE_COOKIE=0
